// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Country {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique // e.g. "CL"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores Store[]
  users  User[] // Admins of this country
}

model Store {
  id        String  @id @default(uuid())
  name      String
  address   String?
  countryId String
  country   Country @relation(fields: [countryId], references: [id])

  // Shopify Connection details for this store (Client Credentials)
  shopifyUrl          String?
  shopifyClientId     String?
  shopifyClientSecret String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     UserStore[]
  sales     Sale[]
  inventory Inventory[]
}

enum Role {
  SUPER_ADMIN
  COUNTRY_ADMIN
  CLERK
  VISITOR
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  name     String
  role     Role   @default(CLERK)

  // If COUNTRY_ADMIN, which country they manage
  countryId String?
  country   Country? @relation(fields: [countryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores UserStore[]
  sales  Sale[]
  goals  SalesGoal[]
}

// Join table for User-Store many-to-many relationship
model UserStore {
  userId  String
  storeId String
  user    User   @relation(fields: [userId], references: [id])
  store   Store  @relation(fields: [storeId], references: [id])

  @@id([userId, storeId])
}

model Customer {
  id    String  @id @default(uuid())
  rut   String? @unique
  name  String
  email String?
  phone String?

  // Sincronización con Shopify
  shopifyId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]
}

model Product {
  id             String  @id @default(uuid())
  shopifyId      String  @unique
  sku            String?
  name           String
  family         String? // Botas, Balerinas, etc.
  style          String? // Bailarina, Blucher, Tacón, Botín, Sandalia, Yute, Running, etc.
  color          String?
  size           String
  price          Float
  compareAtPrice Float?
  status         String  @default("active")
  imageUrl       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory Inventory[]
  saleItems SaleItem[]
  costLink  ProductCostLink?
}

model Inventory {
  id        String @id @default(uuid())
  storeId   String
  productId String
  quantity  Int    @default(0)

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([storeId, productId])
}

enum SaleType {
  NORMAL
  RETAIL
  EXCHANGE
}

model Sale {
  id         String   @id @default(uuid())
  storeId    String
  userId     String? // Puede ser nulo en caso de Retail (Vendedor: DFYF)
  customerId String?
  type       SaleType @default(NORMAL)
  total      Float    @default(0)
  notes      String? // Ej: Regalo para amiga, Boda

  // Campos adicionales para reportes e ingesta histórica
  date          DateTime @default(now())
  vendedor      String? // Beatriz, Marite, Vicky, ONLINE, EVENTO, etc.
  channel       String? // ONLINE, OFFLINE, EVENTO
  paymentMethod String?
  paymentBank   String?

  store    Store      @relation(fields: [storeId], references: [id])
  user     User?      @relation(fields: [userId], references: [id])
  customer Customer?  @relation(fields: [customerId], references: [id])
  items    SaleItem[]

  createdAt DateTime @default(now())
}

model SaleItem {
  id        String @id @default(uuid())
  saleId    String
  productId String

  quantity Int // Puede ser negativo en caso de Devolución/Cambio
  price    Float
  discount Float @default(0)

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model SalesGoal {
  id     String @id @default(uuid())
  userId String
  month  Int
  year   Int
  target Float

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, month, year])
}

// ============================================================
// MÓDULO FINANZAS (ver docs/modulo-finanzas.md)
// Montos en CLP sin IVA salvo que el campo diga lo contrario.
// ============================================================

enum ImportTransport {
  AIR
  SEA
}

enum ImportOrderStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
}

enum ImportCostType {
  FACTORY_INVOICE
  FREIGHT
  INSURANCE
  CUSTOMS_AGENT
  DUTIES
  LOCAL_TRANSPORT
  BANK_FEES
  OTHER
  IMPORT_VAT // Solo informativo (crédito fiscal), nunca suma al costo
}

enum FinanceCurrency {
  CLP
  EUR
  USD
}

enum ImportItemCategory {
  FOOTWEAR
  ACCESSORY
  PACKAGING
}

enum ExpenseCategory {
  RENT
  COMMON_EXPENSES
  SALARIES
  COMMISSIONS
  MARKETING
  ACCOUNTING
  FRANCHISE_FEE
  UTILITIES
  SUPPLIES
  EVENTS
  BANK_FEES
  SHIPPING
  INSURANCE
  TAXES_OTHER
  CAPEX
  FINANCIAL_COST
  OTHER
}

enum ExpenseKind {
  FIXED
  VARIABLE
}

enum CostMatchSource {
  AUTO // Asignado por coincidencia de nombre
  MANUAL // Asignado a mano en "Costos por producto"
}

model ImportOrder {
  id          String            @id @default(uuid())
  code        String            @unique // "P1"
  name        String
  season      String? // "SS25"
  transport   ImportTransport
  orderDate   DateTime?
  arrivalDate DateTime?
  eurClpRate  Float // Tipo de cambio de la factura de fábrica
  status      ImportOrderStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  costs ImportOrderCost[]
  items ImportOrderItem[]
}

model ImportOrderCost {
  id             String          @id @default(uuid())
  orderId        String
  type           ImportCostType
  supplier       String?
  documentNumber String?
  date           DateTime?
  currency       FinanceCurrency @default(CLP)
  amount         Float
  fxRate         Float           @default(1)
  amountClp      Float // amount * fxRate
  vatAmount      Float           @default(0)
  documentUrl    String? // Ruta en el bucket privado "finanzas-documentos"
  notes          String?
  importKey      String?         @unique // Para que la carga CSV sea idempotente
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  order ImportOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ImportOrderItem {
  id               String             @id @default(uuid())
  orderId          String
  category         ImportItemCategory @default(FOOTWEAR)
  style            String? // Bailarina, Blucher...
  model            String? // "Amatista"
  color            String? // "black"
  modelKey         String // "amatista black" (minúsculas, sin tildes)
  quantityInvoiced Int
  quantityReceived Int
  unitCostEur      Float // Precio fábrica sin IVA
  retailPrice      Float? // PVP con IVA
  sizeBreakdown    Json? // {"36":1,"37":2}

  // Recalculados cada vez que cambia el pedido (ver finance-calc.ts)
  factoryCostClp    Float @default(0)
  allocatedExtraClp Float @default(0)
  landedUnitCostClp Float @default(0)

  importKey String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order ImportOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([modelKey])
}

model ProductCostLink {
  id          String          @id @default(uuid())
  productId   String          @unique
  modelKey    String
  unitCost    Float // Promedio ponderado de landedUnitCostClp
  method      String          @default("WEIGHTED_AVERAGE")
  matchSource CostMatchSource @default(AUTO)
  updatedAt   DateTime        @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@index([modelKey])
}

model Expense {
  id             String          @id @default(uuid())
  date           DateTime // Fecha del documento
  period         String // "YYYY-MM" al que se imputa
  category       ExpenseCategory
  kind           ExpenseKind     @default(FIXED)
  supplier       String?
  description    String
  amountNet      Float
  vatAmount      Float           @default(0)
  paymentMethod  String?
  documentUrl    String?
  notes          String?
  amortizeMonths Int? // Ej. canon: se muestra prorrateado en el resultado
  importKey      String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([period])
}

model CapitalContribution {
  id        String   @id @default(uuid())
  date      DateTime
  partner   String
  amount    Float
  notes     String?
  importKey String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Caja real del negocio en una fecha (input manual para el "hoyo neto")
model CashBalance {
  id        String   @id @default(uuid())
  date      DateTime
  amount    Float
  notes     String?
  createdAt DateTime @default(now())
}

// Venta mayorista (Paris, Falabella): factura fuera del POS. Los pares salen de los pedidos
// de importación ya registrados; el costo de ventas usa el promedio ponderado del modelo.
model WholesaleSale {
  id            String              @id @default(uuid())
  customer      String
  invoiceNumber String
  date          DateTime // Fecha de emisión de la factura
  period        String // "YYYY-MM" en que se reconoce el ingreso
  vatAmount     Float               @default(0)
  documentUrl   String?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  lines         WholesaleSaleLine[]

  @@unique([customer, invoiceNumber])
  @@index([period])
}

model WholesaleSaleLine {
  id           String        @id @default(uuid())
  saleId       String
  sale         WholesaleSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  description  String // Texto de la factura
  modelKey     String // Modelo de importación del que salen los pares
  quantity     Int
  unitPriceNet Float // Precio unitario neto (sin IVA)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([saleId])
}
